KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=replace_me
KEITARO_TIMEOUT=20
KEITARO_DOMAIN_NAME=kylovoa.com
KEITARO_GROUP_NAME=FORTESTS
KEITARO_TRAFFIC_SOURCE_NAME=FORTESTS
# Exact key from GET /admin_api/v1/streams_actions for direct HTTP redirect in YOUR tracker.
KEITARO_STREAM_ACTION_TYPE=http
# Process-wide cache of GET /offers (autocomplete + editor load), seconds. 0 disables it.
KEITARO_OFFERS_CACHE_TTL=30
# Defaults to backend/campaign_creator.db (absolute path, CWD-independent).
# SQLite is used with aiosqlite. Set an async PostgreSQL URL for deployment.
# DATABASE_URL=postgresql+asyncpg://user:password@host/db
CORS_ORIGINS=http://localhost:5173
# Optional shared secret. When set, every /api route except /api/health requires
# X-API-Token or Authorization: Bearer. Leave empty for local development.
API_AUTH_TOKEN=
# Run schema creation/migrations on startup. Set to false and run
# `python -m scripts.init_db` once when starting multiple workers.
AUTO_MIGRATE=true
# Prefix of the generated Keitaro campaign name. It is used verbatim, so include
# the separator if one is needed (the documented default is "test_").
CAMPAIGN_NAME_PREFIX=test_sorokin_
